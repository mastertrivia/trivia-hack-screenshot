<!-- The search engine, OCR (tesseract/vision) and question log settings were removed
     together with that functionality. The screenshot saving switch stays, plus a
     slider for the floating button size. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory android:title="Logs/Debug Settings" />

    <SwitchPreference
        android:defaultValue="true"
        android:key="@string/save_image_and_file_to_storage_key"
        android:summary="@string/image_storage_details"
        android:title="@string/image_storage_titile" />

    <PreferenceCategory android:title="Floating Button" />

    <SeekBarPreference
        android:key="floating_button_size"
        android:max="100"
        android:summary="64 dp"
        android:title="@string/floating_button_size_title" />

</PreferenceScreen>
