<?xml version="1.0" encoding="utf-8"?>
<!-- Floating screenshot button, SUCCESS state: green circle with white
     checkmark shown while confirming a capture that was really saved. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/card_start_green" />
    <stroke
        android:width="3dp"
        android:color="#FFFFFFFF" />
    <size
        android:width="64dp"
        android:height="64dp" />
</shape>
