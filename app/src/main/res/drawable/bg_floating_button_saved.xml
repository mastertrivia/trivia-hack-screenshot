<?xml version="1.0" encoding="utf-8"?>
<!-- Floating screenshot button, CONFIRMED state: red circle with a green
     border, shown for ~1.5s after the checkmark to signal that the last
     screenshot was saved. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/card_stop_red" />
    <stroke
        android:width="3dp"
        android:color="@color/card_start_green" />
    <size
        android:width="64dp"
        android:height="64dp" />
</shape>
