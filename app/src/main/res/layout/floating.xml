<!-- One round, draggable floating screenshot button. The window size is set at
     runtime from the "Floating button size" setting (Floating.java). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/head"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_floating_button"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/start_screenshot"
        android:padding="14dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_camera_white" />

</LinearLayout>
